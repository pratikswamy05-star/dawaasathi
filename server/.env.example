# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TZ=Asia/Kolkata

# REQUIRED in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Database ---
# Leave DATABASE_URL empty to use the built-in embedded PostgreSQL (PGlite) stored in ./data/pglite.
# Set it to use a real PostgreSQL / Supabase database, e.g.
#   DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=

# --- Demo ---
# true = seed demo data, allow the demo clock controls. Set false in production.
DEMO_MODE=true

# --- Missed-dose escalation (minutes after the scheduled time) ---
REMINDER_1_MIN=10
REMINDER_2_MIN=20
CAREGIVER_ALERT_MIN=45
# Repeated misses -> ASHA alert
REPEAT_MISS_THRESHOLD=3
REPEAT_MISS_WINDOW_DAYS=7

# --- Refill prediction (days of stock left) ---
REFILL_SOON_DAYS=7
REFILL_CRITICAL_DAYS=3
REFILL_BUFFER_DAYS=2

# --- Optional: AI answers in the voice assistant ---
# Leave empty to use the built-in rule-based assistant (works offline, no key needed).
# If set, free-form questions the rules cannot answer go to Claude. The key stays on the server.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
